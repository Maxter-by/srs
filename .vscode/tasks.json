{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🏗️ Fast Build",
      "type": "shell",
      "command": "make -j$(nproc)",
      "options": {
        "cwd": "${workspaceFolder}/trunk"
      },
      "group": "build"
    },
    {
      "label": "🔨 Full Rebuild",
      "type": "shell",
      "command": "./configure && make -j$(nproc)",
      "options": {
        "cwd": "${workspaceFolder}/trunk"
      },
      "group": "build"
    },
    {
      "label": "🚀 Run SRS",
      "type": "shell",
      "command": "./objs/srs -c /www/wwwroot/stream.skore.tech/srs/srs.conf",
      "options": {
        "cwd": "${workspaceFolder}/trunk"
      },
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*"
        }
      },
      "dependsOn": [
        "💀 Kill SRS"
      ]
    },
    {
      "label": "💀 Kill SRS",
      "type": "shell",
      "command": "pkill -f './objs/srs' || true",
      "options": {
        "cwd": "${workspaceFolder}/trunk"
      },
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": []
    },
    {
      "label": "💎 Full Cycle (Kill -> Build -> Run)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "💀 Kill SRS",
        "🏗️ Fast Build",
        "🚀 Run SRS"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}